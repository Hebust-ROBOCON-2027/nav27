<?xml version="1.0"?>
<sdf version="1.7">
  <model name="mecanum_wheel">
    <link name="wheel_link">
      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.00256</ixx>
          <iyy>0.00448</iyy>
          <izz>0.00256</izz>
        </inertia>
      </inertial>

      <!-- Visual: 使用详细 DAE mesh -->
      <visual name="visual">
        <pose>0 0 0 0 1.5708 0</pose>
        <geometry>
          <mesh>
            <uri>model://rmua19_standard_robot/meshes/wheel_left01.dae</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>
      </visual>

      <!-- Collision: 使用简化圆柱体 -->
      <collision name="collision">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.0758</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.8</mu>
              <mu2>0.8</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>
  </model>
</sdf>
